```gitignore
# Compiled and build artifacts
*.class
*.o
*.obj
*.out
build/
target/

# Dependencies
.gradle/
lib/
deps/

# Logs and temp files
*.log
*.tmp
*.swp

# Environment
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/
*.swp
*.swo

# OS specific
.DS_Store
Thumbs.db

# Coverage
coverage/
htmlcov/
.coverage

# Python (if applicable)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg-info/
.eggs/

# Node.js (if applicable)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Java build tools (if applicable)
*.jar
*.war
*.ear
!*.java

# Maven
target/

# Gradle
.gradle/
build/

# Local configuration
*.local
config/local.*
!config/application.yml
!config/application.properties
```